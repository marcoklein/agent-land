PORT=3000
SECRETS_DIR=./secrets
DATA_DIR=./data
AGENT_IMAGE=agent-land-pi:latest
AGE_KEY_FILE=./.age-key
OPENCODE_API_KEY=sk-xxx
DEFAULT_MODEL=deepseek-v4-pro

# Fallback git identity, injected into sessions whose connectors provide none (leave blank to skip)
GIT_USER_NAME=
GIT_USER_EMAIL=

# Public address of the JSON/SSE API, injected into platform-enabled sessions
# (defaults to http://localhost:PORT; set to an address reachable from agent containers)
AGENT_LAND_URL=http://localhost:3000

# Operator credential for server-side API auth (optional). Either form works:
# AGENT_LAND_BASIC_AUTH=user:password
# AGENT_LAND_AUTH_USER=user
# AGENT_LAND_AUTH_PASSWORD=password
