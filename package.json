{
  "name": "agent-land",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch packages/server/src/server.ts",
    "build": "pnpm --filter \"@agent-land/*\" build",
    "start": "node packages/server/dist/server.js",
    "typecheck": "pnpm --filter \"@agent-land/*\" typecheck",
    "test": "pnpm --filter \"@agent-land/*\" test",
    "test:watch": "pnpm --filter @agent-land/server test:watch",
    "al": "pnpm --filter @agent-land/cli start"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
