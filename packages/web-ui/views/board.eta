<div id="board" hx-get="/board" hx-trigger="every 15s" hx-target="#board" hx-swap="innerHTML">
  <h1>Tickets board</h1>
  <% if (it.generatedAt) { %>
    <p><small>generated <%~ it.generatedAt %></small></p>
  <% } %>

  <% if (it.error) { %>
    <article><p><strong>Error:</strong> <%~ it.error %></p></article>
  <% } else if (!it.configured) { %>
    <article>
      <p>No ticket board configured.</p>
      <p>
        <small>
          Set <code>TICKETS_BOARD_FILE</code> to the path of a
          <code>board.json</code> snapshot (generated by <code>tk board</code>
          in the tickets repo).
        </small>
      </p>
    </article>
  <% } else { %>
    <div class="grid">
      <% it.columns.forEach(function (col) { %>
        <article>
          <header><strong><%= col.name %></strong> <mark><%= col.count %></mark></header>
          <% if (col.tickets.length) { %>
            <ul>
              <% col.tickets.forEach(function (t) { %>
                <li>
                  <strong><%= t.id %></strong>
                  <small>[P<%= t.priority %>]</small>
                  <%= t.title %>
                  <% if (t.status === "in_progress") { %><mark>in progress</mark><% } %>
                  <% if (t.lastStatus) { %><br><small><%~ t.lastStatus %></small><% } %>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p><small>empty</small></p>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>
