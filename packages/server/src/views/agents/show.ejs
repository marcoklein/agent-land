<article hx-get="/agents/<%= session.id %>"
         hx-trigger="<%= session.status !== 'stopped' ? 'agent-done from:#log-container' : '' %>"
         hx-swap="outerHTML">
  <header class="agent-header">
    <hgroup>
      <h2>Session <code><%= session.id %></code></h2>
      <p>
        <strong>Provider:</strong> <%= session.provider || 'opencode-go' %><br>
        <strong>Model:</strong> <%= session.model %><br>
        <strong>Policy:</strong> <%= session.permissionPolicy %><br>
        <strong>Connectors:</strong> <%= session.connectors.join(", ") || "none" %><br>
        <strong>Created:</strong> <%= new Date(session.createdAt).toLocaleString() %>
        <% if (session.updatedAt) { %>
        <br><strong>Updated:</strong> <%= new Date(session.updatedAt).toLocaleString() %>
        <% } %>
      </p>
    </hgroup>
    <span id="status-badge"
          hx-get="/agents/<%= session.id %>/status-badge"
          hx-trigger="<%= session.status !== 'stopped' ? 'agent-done from:#log-container' : '' %>">
      <mark class="<%= session.status === 'running' ? '' : session.status === 'idle' ? 'pico-color-jade-100' : session.status === 'waiting_for_input' ? 'pico-color-yellow-100' : 'pico-color-red-100' %>">
        <%= session.status %>
      </mark>
    </span>
  </header>

  <% if (session.status === 'waiting_for_input' && session.waitingFor) { %>
  <div class="log-tool log-tool-err">
    Waiting for input (<%= session.waitingFor.method %>)<% if (session.waitingFor.prompt) { %>: <%= session.waitingFor.prompt %><% } %>
  </div>
  <form method="post" action="/agents/<%= session.id %>/respond" class="respond-form">
    <input type="hidden" name="requestId" value="<%= session.waitingFor.requestId %>">
    <% if (session.waitingFor.method === 'confirm') { %>
    <button type="submit" name="action" value="confirm">Confirm</button>
    <button type="submit" name="action" value="cancel" class="secondary">Cancel</button>
    <% } else { %>
    <input type="text" name="value" placeholder="Your answer" required>
    <button type="submit">Send</button>
    <% } %>
  </form>
  <% } %>

  <h4>Logs</h4>
  <div id="log-container"
       class="log-container"
       <% if (session.status !== 'stopped') { %>
       hx-sse:connect="/agents/<%= session.id %>/events?after=<%= totalEventCount %>"
       hx-swap="afterbegin"
       hx-sse:close="agent-done"
       <% } %>>
    <% if (session.status === 'stopped') { %>
    <div class="run-completed">Session stopped</div>
    <% } %>
    <%- renderedLogs.reverse().join("\n") %>
  </div>

  <footer class="agent-footer">
    <a href="/agents" role="button" class="outline">Back to Sessions</a>
    <% if (session.status !== 'stopped') { %>
    <a href="#" role="button" class="outline destructive"
       hx-post="/agents/<%= session.id %>/kill"
       hx-confirm="Kill this session?">Kill Session</a>
    <% } %>
  </footer>
</article>
