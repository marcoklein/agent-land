<article>
  <header>
    <h2>Sessions</h2>
    <small>Live agent sessions and history.</small>
  </header>

  <a href="/agents/new" role="button">Launch Session</a>

  <% if (sessions.length === 0) { %>
  <p><em>No sessions yet.</em></p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Provider</th>
        <th>Model</th>
        <th>Connectors</th>
        <th>Policy</th>
        <th>Status</th>
        <th>Created</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% sessions.forEach(session => { %>
      <tr>
        <td><code><%= session.id %></code></td>
        <td><small><%= session.provider || 'opencode-go' %></small></td>
        <td><small><%= session.model %></small></td>
        <td><small><%= session.connectors.join(", ") || "none" %></small></td>
        <td><small><%= session.permissionPolicy %></small></td>
        <td><mark id="status-<%= session.id %>" class="<%= session.status === 'running' ? '' : session.status === 'idle' ? 'pico-color-jade-100' : session.status === 'waiting_for_input' ? 'pico-color-yellow-100' : 'pico-color-red-100' %>"><%= session.status %></mark></td>
        <td><small><%= new Date(session.createdAt).toLocaleString() %></small></td>
        <td><a href="/agents/<%= session.id %>">View</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</article>
