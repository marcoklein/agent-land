<article>
  <header><h2>Add Connector</h2></header>
  <p><small>Define an external system connection and its credentials. The secret is encrypted at rest with SOPS/Age.</small></p>

  <form method="POST" action="/connectors">
    <label for="name">Connector name</label>
    <input type="text" id="name" name="name" placeholder="e.g. Work Jira" required>

    <label for="type">Type</label>
    <select id="type" name="type" required
            hx-get="/connectors/fields"
            hx-target="#secret-fields"
            hx-trigger="change, load"
            hx-include="this"
            hx-swap="innerHTML">
      <option value="jira">Jira</option>
      <option value="github">GitHub</option>
      <option value="gmail">Gmail</option>
      <option value="custom">Custom</option>
    </select>

    <label for="url">URL</label>
    <input type="text" id="url" name="url" placeholder="e.g. https://your-domain.atlassian.net" required>

    <div id="secret-fields">
      <label for="JIRA_EMAIL">Email</label>
      <input type="text" id="JIRA_EMAIL" name="JIRA_EMAIL" placeholder="you@example.com" required>

      <label for="JIRA_API_TOKEN">API Token</label>
      <input type="text" id="JIRA_API_TOKEN" name="JIRA_API_TOKEN" placeholder="..." required>

      <small>Encrypted at rest with SOPS/Age. Decrypted only at agent launch time.</small>
    </div>

    <button type="submit">Create Connector</button>
    <a href="/connectors" role="button" class="outline">Cancel</a>
  </form>
</article>
