<article>
  <header><h2>Dashboard</h2></header>

  <div class="grid">
    <div>
      <h3>Sessions</h3>
      <p><strong><%= sessionCount %></strong> sessions total<% if (runningCount > 0) { %>, <mark><%= runningCount %> running</mark><% } %></p>
      <a href="/agents" role="button" class="outline">View all</a>
      <a href="/agents/new" role="button">Launch new</a>
    </div>
    <div>
      <h3>Connectors</h3>
      <p><strong><%= connectorCount %></strong> defined</p>
      <a href="/connectors" role="button" class="outline">View all</a>
      <a href="/connectors/new" role="button">Add</a>
    </div>

  </div>

  <% if (recentSessions.length > 0) { %>
  <h3 style="margin-top:24px">Recent Sessions</h3>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Model</th>
        <th>Status</th>
        <th>Created</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% recentSessions.forEach(session => { %>
      <tr>
        <td><code><%= session.id %></code></td>
        <td><small><%= session.model %></small></td>
        <td><mark class="<%= session.status === 'running' ? '' : session.status === 'idle' ? 'pico-color-jade-100' : session.status === 'waiting_for_input' ? 'pico-color-yellow-100' : 'pico-color-red-100' %>"><%= session.status %></mark></td>
        <td><small><%= new Date(session.createdAt).toLocaleString() %></small></td>
        <td><a href="/agents/<%= session.id %>">View</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</article>
