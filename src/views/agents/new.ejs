<article>
  <header><h2>Launch Session</h2></header>
  <p><small>Starts a long-lived pi agent (<code>--mode rpc</code>) in a Docker container with the selected connectors' credentials. Connector info is prepended automatically — just write your first prompt.</small></p>

  <form method="POST" action="/agents/run">
    <label for="task">Initial Prompt</label>
    <textarea id="task" name="task" rows="4"
              placeholder="Clone github.com/me/my-project, read Jira issue ABC-123, and fix the login rate limiting"></textarea>

    <fieldset>
      <legend>Connectors</legend>
      <% connectors.forEach(c => { %>
      <label>
        <input type="checkbox" name="connectors" value="<%= c.name %>">
        <strong><%= c.name %></strong> <small>(<%= c.type %>)</small>
      </label>
      <% }) %>
      <% if (connectors.length === 0) { %>
      <p><small><em>No connectors defined. <a href="/connectors/new">Create one</a> first.</em></small></p>
      <% } %>
    </fieldset>

    <label for="model">Model <% if (models.length > 0) { %><small>(<%= models.length %> available)</small><% } %></label>
    <select id="model" name="model">
      <% models.forEach(m => { %>
        <option value="<%= m %>"<%= m === 'deepseek-v4-pro' ? ' selected' : '' %>><%= m %></option>
      <% }) %>
    </select>

    <label for="permissionPolicy">Permission Policy</label>
    <select id="permissionPolicy" name="permissionPolicy">
      <option value="auto" selected>Auto (answer dialogs automatically)</option>
      <option value="manual">Manual (pause for confirmation)</option>
    </select>

    <button type="submit">Launch Session</button>
    <a href="/agents" role="button" class="outline">Cancel</a>
  </form>
</article>
