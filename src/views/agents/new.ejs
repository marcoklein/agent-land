<article>
  <header><h2>Launch Agent</h2></header>
  <p><small>Runs <code>pi --mode json</code> in a Docker container with the selected connectors' credentials. Connector info is prepended automatically — just write your task.</small></p>

  <form method="POST" action="/agents/run">
    <label for="task">Task / Prompt</label>
    <textarea id="task" name="task" rows="4"
              placeholder="Clone github.com/me/my-project, read Jira issue ABC-123, and fix the login rate limiting" required></textarea>

    <fieldset>
      <legend>Connectors</legend>
      <% connectors.forEach(c => { %>
      <label>
        <input type="checkbox" name="connectors" value="<%= c.name %>">
        <strong><%= c.name %></strong> <small>(<%= c.type %>)</small>
      </label>
      <% }) %>
      <% if (connectors.length === 0) { %>
      <p><small><em>No connectors defined. <a href="/connectors/new">Create one</a> first.</em></small></p>
      <% } %>
    </fieldset>

    <label for="model">Model <% if (models.length > 0) { %><small>(<%= models.length %> available)</small><% } %></label>
    <select id="model" name="model">
      <% models.forEach(m => { %>
        <option value="<%= m %>"<%= m === 'deepseek-v4-pro' ? ' selected' : '' %>><%= m %></option>
      <% }) %>
    </select>

    <details>
      <summary>Kill Switch</summary>
      <div class="kill-switch-grid">
        <label>
          Timeout (seconds)
          <input type="number" name="timeout" value="3600" min="0" placeholder="3600">
        </label>
        <label>
          Max Tokens
          <input type="number" name="maxTokens" value="100000" min="0" placeholder="100000">
        </label>
        <label>
          Max Cost ($)
          <input type="number" name="maxCost" value="1" min="0" step="0.01" placeholder="1.00">
        </label>
      </div>
      <small>Agent will be killed if it exceeds any of these limits. Leave empty to disable.</small>
    </details>

    <button type="submit">Launch Agent</button>
    <a href="/agents" role="button" class="outline">Cancel</a>
  </form>
</article>
