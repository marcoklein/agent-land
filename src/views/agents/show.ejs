<article hx-get="/agents/<%= run.id %>"
         hx-trigger="<%= run.status === 'running' ? 'agent-done from:#log-container' : '' %>"
         hx-swap="outerHTML">
  <header class="agent-header">
    <hgroup>
      <h2>Agent <code><%= run.id %></code></h2>
      <p>
        <strong>Task:</strong>
        <details>
          <summary><small><%= run.task.substring(0, 100) %><%= run.task.length > 100 ? '...' : '' %></small></summary>
          <pre class="agent-task-pre"><%= run.task %></pre>
        </details>
        <br>
        <strong>Connectors:</strong> <%= run.connectors.join(", ") || "none" %><br>
        <strong>Model:</strong> <%= run.model %><br>
        <strong>Started:</strong> <%= new Date(run.startedAt).toLocaleString() %>
        <% if (run.finishedAt) { %>
        <br><strong>Finished:</strong> <%= new Date(run.finishedAt).toLocaleString() %>
        <% } %>
        <span id="agent-stats"
              hx-get="/agents/<%= run.id %>/stats"
              hx-trigger="<%= run.status === 'running' ? 'every 2s' : '' %>"
              hx-swap="innerHTML">
          <% if (run.finishedAt) { %>
          <br><strong>Duration:</strong> <%= formatDuration((new Date(run.finishedAt).getTime() - new Date(run.startedAt).getTime()) / 1000) %>
          <% } else { %>
          <br><strong>Duration:</strong> <%= formatDuration((Date.now() - new Date(run.startedAt).getTime()) / 1000) %>
          <% } %>
          <% if (run.totalTokens) { %>
          <br><strong>Tokens:</strong> <%= run.totalTokens.toLocaleString() %><% if (run.killSwitch.maxTokens) { %> / <%= run.killSwitch.maxTokens.toLocaleString() %><% } %>
          <% } %>
          <% if (run.totalCost) { %>
          <br><strong>Cost:</strong> $<%= run.totalCost.toFixed(4) %><% if (run.killSwitch.maxCost) { %> / $<%= run.killSwitch.maxCost %><% } %>
          <% } %>
        </span>
      </p>
    </hgroup>
    <span id="status-badge"
          hx-get="/agents/<%= run.id %>/status-badge"
          hx-trigger="<%= run.status === 'running' ? 'agent-done from:#log-container' : '' %>">
      <mark class="<%= run.status === 'running' ? '' : run.status === 'completed' ? 'pico-color-jade-100' : run.status === 'killed' ? 'pico-color-yellow-100' : 'pico-color-red-100' %>">
        <%= run.status %><% if (run.killReason) { %>: <%= run.killReason %><% } %>
      </mark>
    </span>
  </header>

  <h4>Logs</h4>
  <div id="log-container"
       class="log-container"
       <% if (run.status === 'running') { %>
       hx-sse:connect="/agents/<%= run.id %>/logs?after=<%= totalLogCount %>"
       hx-swap="afterbegin"
       hx-sse:close="agent-done"
       <% } %>>
    <% if (run.status !== 'running') { %>
    <div class="run-completed">Agent <%= run.status %> (exit code: <%= run.exitCode %>)</div>
    <% } %>
    <%- renderedLogs.reverse().join("\n") %>
  </div>

  <footer class="agent-footer">
    <a href="/agents" role="button" class="outline">Back to Agents</a>
    <% if (run.status === 'running') { %>
    <a href="#" role="button" class="outline destructive"
       hx-post="/agents/<%= run.id %>/kill"
       hx-confirm="Kill this agent?">Kill Agent</a>
    <% } %>
    <% if (run.sessionFile) { %>
    <small>Session: <code><%= run.sessionFile %></code></small>
    <% } %>
  </footer>
</article>

