<article>
  <header>
    <h2>Agents</h2>
    <small>Past agent runs and live streaming.</small>
  </header>

  <a href="/agents/new" role="button">Launch Agent</a>

  <% if (runs.length === 0) { %>
  <p><em>No agents have been run yet.</em></p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Task</th>
        <th>Connectors</th>
        <th>Status</th>
        <th>Started</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% runs.forEach(run => { %>
      <tr>
        <td><code><%= run.id %></code></td>
        <td><small><%= run.task.substring(0, 50) %><%= run.task.length > 50 ? '...' : '' %></small></td>
        <td><small><%= run.connectors.join(", ") || "none" %></small></td>
        <td><mark id="status-<%= run.id %>" class="<%= run.status === 'running' ? '' : run.status === 'completed' ? 'pico-color-jade-100' : 'pico-color-red-100' %>"><%= run.status %></mark></td>
        <td><small><%= new Date(run.startedAt).toLocaleString() %></small></td>
        <td><a href="/agents/<%= run.id %>">View</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</article>
