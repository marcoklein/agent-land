<article>
  <header><h2>Add Secret</h2></header>
  <p><small>Paste the YAML content you want to encrypt. It will be stored as <code>secrets/&lt;name&gt;.yaml</code> encrypted with SOPS/Age.</small></p>

  <% if (typeof error !== 'undefined' && error) { %>
    <p style="color: var(--pico-color-red-500);"><%= error %></p>
  <% } %>

  <form method="POST" action="/secrets">
    <label for="name">Secret name</label>
    <input type="text" id="name" name="name" placeholder="e.g. github-personal" value="<%= name %>" required>

    <label for="content">Content (YAML)</label>
    <textarea id="content" name="content" rows="8" placeholder="GITHUB_TOKEN: ghp_xxx&#10;GITHUB_API_URL: https://api.github.com" required><%= content %></textarea>

    <button type="submit">Encrypt & Save</button>
    <a href="/secrets" role="button" class="outline">Cancel</a>
  </form>
</article>
