<article>
  <header>
    <h2>Secrets</h2>
    <small>SOPS/Age-encrypted YAML files. Never stored in plaintext.</small>
  </header>

  <a href="/secrets/new" role="button">Add Secret</a>

  <% if (secrets.length === 0) { %>
  <p><em>No secrets yet.</em></p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>File</th>
        <th>Size</th>
        <th>Modified</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% secrets.forEach(s => { %>
      <tr>
        <td><code><%= s.name %></code></td>
        <td><small><%= s.filename %></small></td>
        <td><small><%= (s.size / 1024).toFixed(1) %> KB</small></td>
        <td><small><%= new Date(s.modifiedAt).toLocaleString() %></small></td>
        <td>
          <form method="POST" action="/secrets/<%= s.name %>/delete" style="display:inline"
                hx-post="/secrets/<%= s.name %>/delete"
                hx-target="closest tr"
                hx-swap="outerHTML"
                hx-confirm="Delete secret '<%= s.name %>'?">
            <button type="submit" class="outline secondary" style="padding:2px 8px;font-size:0.8rem">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</article>
